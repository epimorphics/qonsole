{
  "name": "@epimorphics/qonsole",
  "version": "2.0.0",
  "description": "A web component for issuing SPARQL queries.",
  "keywords": [
    "SPARQL",
    "web-component",
    "query"
  ],
  "homepage": "https://github.com/epimorphics/qonsole",
  "repository": {
    "type": "git",
    "url": "git://github.com/epimorphics/qonsole.git",
    "directory": "packages/qonsole-wc"
  },
  "author": {
    "name": "Epimorphics Limited",
    "url": "https://www.epimorphics.com"
  },
  "license": "Apache-2.0",
  "packageManager": "yarn@4.15.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/qonsole.js",
      "require": "./dist/qonsole.umd.cjs"
    }
  },
  "customElements": "custom-elements.json",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "check": "oxlint src && oxfmt --check src"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "codemirror": "^6.0.0",
    "codemirror-lang-sparql": "^2.1.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "vite": "^5.0.0"
  }
}
